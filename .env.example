# Secret set on the Typeform webhook. Requests without a valid
# Typeform-Signature header are rejected. REQUIRED in production: without it
# the webhook refuses every request (503). Locally it may be left empty.
TYPEFORM_WEBHOOK_SECRET=

# Vercel Blob (PRIVATE store) for generated Beyond Cards. Set automatically
# when a private Blob store is connected to the Vercel project; uploads then
# authenticate with the function's Vercel OIDC token (no read-write token).
# Without it, cards are still generated but not stored (and cannot be previewed).
BLOB_STORE_ID=
# Optional legacy alternative to BLOB_STORE_ID + OIDC.
# BLOB_READ_WRITE_TOKEN=

# Resend, for Beyond Card emails.
RESEND_API_KEY=
EMAIL_FROM=BOURZMA <onboarding@resend.dev>

# Enables the TEST email endpoint POST /api/email/test (header
# x-email-test-key) and the /email-test page. Leave empty to disable (404).
# Automatic emails for Typeform submissions are not implemented yet.
EMAIL_TEST_KEY=

# Enables GET /api/cards/<Beyond ID>?key=<this value> to preview stored cards.
# Leave empty to disable the preview route (404).
CARD_PREVIEW_KEY=
